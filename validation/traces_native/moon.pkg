import {
  "bobzhang/yrs/validation/traces_core" @traces,
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "executable")

options(
  "native-stub": [ "read_file.c" ],
  targets: { "ffi.mbt": [ "native" ], "other.mbt": [ "not", "native" ] },
)

supported_targets = "native"
