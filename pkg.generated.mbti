// Type aliases

// Traits
pub(open) trait AsyncProtocol {
  async fn start(Self, Awareness) -> Bytes = _
  async fn handle(Self, Awareness, Bytes) -> Array[Message] = _
  async fn handle_message(Self, Awareness, Message) -> Message? = _
  async fn handle_sync_step1(Self, Awareness, StateVector) -> Message? = _
  async fn handle_sync_step2(Self, Awareness, Update) -> Message? = _
  async fn handle_update(Self, Awareness, Update) -> Message? = _
  async fn handle_auth(Self, Awareness, String?) -> Message? = _
  async fn handle_awareness_query(Self, Awareness) -> Message? = _
  async fn handle_awareness_update(Self, Awareness, AwarenessUpdate) -> Message? = _
  async fn missing_handle(Self, Awareness, Byte, Bytes) -> Message? = _
}

pub(open) trait Protocol {
  fn start(Self, Awareness) -> Bytes raise = _
  fn handle(Self, Awareness, Bytes) -> Array[Message] raise = _
  fn handle_message(Self, Awareness, Message) -> Message? raise = _
  fn handle_sync_step1(Self, Awareness, StateVector) -> Message? raise = _
  fn handle_sync_step2(Self, Awareness, Update) -> Message? raise = _
  fn handle_update(Self, Awareness, Update) -> Message? raise = _
  fn handle_auth(Self, Awareness, String?) -> Message? raise = _
  fn handle_awareness_query(Self, Awareness) -> Message? raise = _
  fn handle_awareness_update(Self, Awareness, AwarenessUpdate) -> Message? raise = _
  fn missing_handle(Self, Awareness, Byte, Bytes) -> Message? raise = _
}

pub trait RootRef : SharedRef {
  fn get_or_insert_root(Doc, String) -> Self
}

pub trait SharedRef {
  fn from_branch(Doc, BranchId) -> Self?
}
